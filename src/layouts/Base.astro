---
import '../styles/fonts.css';
import '../styles/tokens.css';
import '../styles/base.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { LOCALE_META, LOCALES, type Locale, type Track } from '../i18n';
import { t, url } from '../i18n';

interface Props {
  locale: Locale;
  track?: Track;
  title?: string;
  description?: string;
  /** Path (after the locale) of THIS page in each locale, for hreflang + switcher.
   *  e.g. ['mobile','p','aratc'] -> /en/mobile/p/aratc/ */
  pathParts?: (string | number)[];
  /** OG image absolute-from-base path, e.g. 'og/en-mobile.png' */
  ogImage?: string;
  /** Hide the chrome (used by the CV print page). */
  bare?: boolean;
  /** Full-viewport canvas page: floating transparent header, no footer, no page scroll. */
  immersive?: boolean;
  /** Canonical path (after the locale) when this page duplicates another, e.g. a
   *  project page under each track → the 'all' one. Defaults to pathParts. */
  canonicalParts?: (string | number)[];
  /** schema.org objects to embed as JSON-LD */
  jsonLd?: object[];
  /** keep out of search results (404) */
  noindex?: boolean;
}

const {
  locale,
  track = 'all',
  title,
  description,
  pathParts = [],
  ogImage,
  bare = false,
  immersive = false,
  canonicalParts,
  jsonLd = [],
  noindex = false,
} = Astro.props;

const meta = LOCALE_META[locale];
const pageTitle = title ? `${title} — ${t(locale, 'site.name')}` : t(locale, 'site.title');
const desc = description ?? t(locale, 'site.tagline');
const canonicalPath = canonicalParts ?? pathParts;
const canonical = new URL(url(locale, ...canonicalPath), Astro.site).href;
const og = new URL(url(ogImage ?? `og/${locale}-${track}.jpg`).replace(/\/$/, ''), Astro.site).href;
const asset = (p: string) => url(p).replace(/\/$/, '');

const buildSha = (process.env.GITHUB_SHA ?? 'dev').slice(0, 7);
const buildDate = new Date().toISOString().slice(0, 10);
---

<!doctype html>
<html lang={meta.htmlLang} dir={meta.dir} data-track={track}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={desc} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
    <meta name="author" content="Mohamed H. Essa" />
    <meta name="theme-color" content="#080808" />
    <meta name="color-scheme" content="dark" />
    <link rel="icon" href={asset('favicon.ico')} sizes="48x48" />
    <link rel="icon" type="image/svg+xml" href={asset('favicon.svg')} />
    <link rel="apple-touch-icon" href={asset('apple-touch-icon.png')} />
    <link rel="manifest" href={asset('site.webmanifest')} />

    {/* hreflang alternates for the same page in every locale */}
    {
      LOCALES.map((l) => (
        <link
          rel="alternate"
          hreflang={LOCALE_META[l].htmlLang}
          href={new URL(url(l, ...canonicalPath), Astro.site).href}
        />
      ))
    }
    <link rel="alternate" hreflang="x-default" href={new URL(url('en', ...canonicalPath), Astro.site).href} />
    <link rel="alternate" type="text/markdown" title="llms.txt" href={asset('llms.txt')} />

    {/* Open Graph / Twitter */}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Mohamed Essa" />
    <meta property="og:locale" content={meta.htmlLang === 'ar' ? 'ar_EG' : meta.htmlLang === 'de' ? 'de_DE' : 'en_US'} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={pageTitle} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={desc} />
    <meta property="og:image" content={og} />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={desc} />
    <meta name="twitter:image" content={og} />
    {jsonLd.map((o) => <script type="application/ld+json" set:html={JSON.stringify(o)} />)}

    <meta name="generator" content={Astro.generator} />
    <slot name="head" />
  </head>
  <body data-track={track} class:list={{ immersive }}>
    <a class="skip-link" href="#main">{t(locale, 'skip')}</a>
    {!bare && <Header locale={locale} track={track} pathParts={pathParts} buildSha={buildSha} floating={immersive} />}
    <main id="main">
      <slot />
    </main>
    {!bare && !immersive && <Footer locale={locale} buildSha={buildSha} buildDate={buildDate} />}
    <script is:inline>
      // Firefox ignores -webkit-user-drag: stop image/link drag ghosts everywhere
      addEventListener('dragstart', function (e) {
        var t = e.target;
        if (t && t.closest && t.closest('img, a, svg')) e.preventDefault();
      });
    </script>
  </body>
</html>
