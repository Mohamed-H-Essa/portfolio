---
// "Flowing paths" (motion kit #15) for the release pipeline: a light pulse
// travels each wire and the next stage lights up as it arrives. Pure CSS: one
// shared cycle, each stage offset by its index. Horizontal on desktop,
// vertical on phones, mirrored in RTL; static (all lit) with reduced motion.
import { t, type Locale } from '../i18n';

interface Props { locale: Locale }
const { locale } = Astro.props;
const steps = ['push', 'build', 'sign', 'upload', 'submit'];
---

<section class="flow shell" aria-labelledby="flow-h">
  <h2 id="flow-h" class="label">{t(locale, 'dossier.flow')}</h2>
  <ol class="flow__steps" style={`--n:${steps.length}`}>
    {
      steps.map((s, i) => (
        <li class="flow__step" style={`--i:${i}`}>
          <span class="flow__node" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
          <span class="flow__name">{t(locale, `flow.${s}`)}</span>
          <span class="flow__sub label">{t(locale, `flow.${s}.sub`)}</span>
          {i < steps.length - 1 && (
            <span class="flow__wire" aria-hidden="true">
              <span class="flow__pulse" />
            </span>
          )}
        </li>
      ))
    }
  </ol>
</section>

<style>
  .flow { --step: 1.1s; --cycle: calc(var(--step) * var(--n)); --c: var(--origin); padding-block: 3rem; }
  .flow h2 { margin-block-end: 2rem; }
  .flow__steps {
    list-style: none;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(var(--n), 1fr);
  }
  .flow__step { position: relative; display: grid; justify-items: center; gap: 0.35rem; text-align: center; }
  .flow__node {
    display: grid;
    place-items: center;
    inline-size: 48px;
    block-size: 48px;
    border-radius: 50%;
    border: 1px solid color-mix(in srgb, var(--c) 40%, transparent);
    background: var(--bg-2);
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--ink-2);
    animation: arrive var(--cycle) var(--ease) infinite;
    animation-delay: calc(var(--step) * var(--i));
  }
  .flow__name { font-size: 1.05rem; margin-block-start: 0.4rem; }
  .flow__sub { font-size: 0.66rem; color: var(--ink-3); }
  .flow__wire {
    position: absolute;
    inset-block-start: 24px;
    inset-inline-start: calc(50% + 30px);
    inline-size: calc(100% - 60px);
    block-size: 1px;
    background: color-mix(in srgb, var(--c) 22%, transparent);
    overflow: hidden;
  }
  :root[dir='rtl'] .flow__wire { transform: scaleX(-1); }
  .flow__pulse {
    position: absolute;
    inset-block: -1px;
    inline-size: 40%;
    background: linear-gradient(90deg, transparent, var(--c), transparent);
    box-shadow: 0 0 12px var(--c);
    transform: translateX(-100%);
    animation: travel var(--cycle) linear infinite;
    animation-delay: calc(var(--step) * var(--i));
  }
  /* the pulse crosses its wire in its stage's 1/5 slice of the cycle (5 stages) */
  @keyframes travel {
    0% { transform: translateX(-100%); opacity: 1; }
    20% { transform: translateX(250%); opacity: 1; }
    21%, 100% { transform: translateX(250%); opacity: 0; }
  }
  @keyframes arrive {
    0% { border-color: var(--c); color: var(--c); box-shadow: 0 0 0 0 color-mix(in srgb, var(--c) 50%, transparent), 0 0 24px color-mix(in srgb, var(--c) 40%, transparent); }
    16% { border-color: var(--c); color: var(--c); box-shadow: 0 0 0 10px transparent, 0 0 18px color-mix(in srgb, var(--c) 25%, transparent); }
    40%, 100% { border-color: color-mix(in srgb, var(--c) 40%, transparent); color: var(--ink-2); box-shadow: none; }
  }

  @media (max-width: 760px) {
    .flow__steps { grid-template-columns: 1fr; gap: 1.6rem; }
    .flow__step {
      grid-template-columns: 48px 1fr;
      justify-items: start;
      align-items: center;
      column-gap: 1rem;
      row-gap: 0.1rem;
      text-align: start;
    }
    .flow__node { grid-row: span 2; }
    .flow__name { margin: 0; }
    .flow__wire {
      inset-block-start: 54px;
      inset-inline-start: 24px;
      inline-size: 1px;
      block-size: calc(100% - 60px + 1.6rem);
    }
    :root[dir='rtl'] .flow__wire { transform: none; }
    .flow__pulse { inset-block: auto; inset-inline: -1px; inline-size: auto; block-size: 40%; transform: translateY(-100%); animation-name: travel-y; }
    .flow__pulse { background: linear-gradient(180deg, transparent, var(--c), transparent); }
    @keyframes travel-y {
      0% { transform: translateY(-100%); opacity: 1; }
      20% { transform: translateY(250%); opacity: 1; }
      21%, 100% { transform: translateY(250%); opacity: 0; }
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .flow__node { animation: none; border-color: var(--c); color: var(--c); }
    .flow__pulse { display: none; }
    .flow__wire { background: color-mix(in srgb, var(--c) 45%, transparent); }
  }
</style>
