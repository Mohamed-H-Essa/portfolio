---
// The timeline map. SSR renders a full SVG scene (crawlable, works with no JS
// as a static diagram). On >=768px the island adds pan/zoom/season-jump.
// On phones the parent page shows the vertical list instead (this is hidden).
import { layoutTimeline, type TLInput } from '../lib/timeline';
import { loc, t, url, type Locale, type Track } from '../i18n';
import { hasAssets, assetUrl } from '../lib/assets';
import type { Project } from '../lib/content';

interface Props {
  projects: Project[];
  locale: Locale;
  track: Track;
  dir: 'ltr' | 'rtl';
}
const { projects, locale, track, dir } = Astro.props;

const input: TLInput[] = projects.map((p) => ({
  slug: p.data.slug,
  code: p.data.code,
  start: p.data.start,
  worlds: p.data.worlds,
  weight: p.data.weight,
  connects: p.data.connects,
}));
const layout = layoutTimeline(input, track, dir);

const titleOf = (slug: string) => {
  const p = projects.find((x) => x.data.slug === slug)!;
  return loc(p.data.title, locale, slug);
};
// SVG text doesn't wrap; keep node titles short so neighbours don't collide.
const shortTitle = (slug: string) => {
  const s = titleOf(slug);
  return s.length > 16 ? s.slice(0, 15).trimEnd() + '…' : s;
};
const hrefOf = (slug: string) => url(locale, track, 'p', slug);

const SEASONS = ['s1', 's2', 's3', 's4'] as const;
// season → representative x (min x of its nodes), for the camera jump
const seasonX: Record<string, number> = {};
for (const p of projects) {
  const n = layout.nodes.find((x) => x.slug === p.data.slug);
  if (!n) continue;
  const e = p.data.era;
  seasonX[e] = seasonX[e] === undefined ? n.x : Math.min(seasonX[e], n.x);
}
---

<div class="tl" data-dir={dir}>
  <div class="tl__head shell">
    <p class="label">{t(locale, 'map.seasons')}</p>
    <div class="tl__seasons" role="group" aria-label={t(locale, 'map.seasons')}>
      {
        SEASONS.map((s) => (
          <button class="tl__season" data-x={seasonX[s] ?? 0} disabled={seasonX[s] === undefined}>
            <span class="tl__season-n">{s.toUpperCase()}</span>
            <span class="tl__season-l">{t(locale, `season.${s}`)}</span>
          </button>
        ))
      }
    </div>
    <p class="label tl__hint">{t(locale, 'map.hint')}</p>
  </div>

  <div class="tl__viewport" tabindex="0" aria-label="Timeline">
    <svg
      class="tl__svg"
      viewBox={`0 0 ${layout.width} ${layout.height}`}
      width={layout.width}
      height={layout.height}
      role="group"
    >
      <!-- year ticks -->
      {
        layout.years.map((y) => (
          <g class="tl__year">
            <line x1={y.x} y1="70" x2={y.x} y2={layout.height - 30} />
            <text x={y.x} y="50">{y.year}</text>
          </g>
        ))
      }
      <!-- lane labels -->
      {
        layout.lanes.map((l) => (
          <text class="tl__lane" x={dir === 'rtl' ? layout.width - 24 : 24} y={l.y - 60} text-anchor={dir === 'rtl' ? 'end' : 'start'}>
            {t(locale, `map.lane.${l.lane}`)}
          </text>
        ))
      }
      <!-- edges -->
      {
        layout.edges.map((e) => {
          const mx = (e.x1 + e.x2) / 2;
          return <path class="tl__edge" d={`M ${e.x1} ${e.y1} C ${mx} ${e.y1}, ${mx} ${e.y2}, ${e.x2} ${e.y2}`} />;
        })
      }
      <!-- nodes -->
      {
        layout.nodes.map((n) => (
          <a class:list={['tl__node', { 'is-dimmed': n.dimmed }]} href={hrefOf(n.slug)} data-slug={n.slug}>
            <circle class="tl__node-halo" cx={n.x} cy={n.y} r="40" />
            {hasAssets(n.slug) ? (
              <image
                href={assetUrl(n.slug, 'thumb')}
                x={n.x - 28}
                y={n.y - 34}
                width="56"
                height="68"
                clip-path="inset(0 round 8px)"
                preserveAspectRatio="xMidYMid slice"
              />
            ) : (
              <circle class="tl__node-dot" cx={n.x} cy={n.y} r="22" />
            )}
            <text class="tl__node-code" x={n.x} y={n.y + 56}>{n.code}</text>
            <text class="tl__node-title" x={n.x} y={n.y + 76}><title>{titleOf(n.slug)}</title>{shortTitle(n.slug)}</text>
          </a>
        ))
      }
    </svg>
  </div>
</div>

<style>
  .tl__head {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem 1.5rem;
    margin-block: 1rem;
  }
  .tl__seasons { display: flex; gap: 0.5rem; flex-wrap: wrap; }
  .tl__season {
    display: inline-flex;
    flex-direction: column;
    align-items: flex-start;
    padding: 0.4rem 0.75rem;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--bg-2);
    transition: border-color var(--dur-fast) var(--ease), color var(--dur-fast) var(--ease);
  }
  .tl__season:hover:not(:disabled) { border-color: var(--accent); }
  .tl__season:disabled { opacity: 0.4; cursor: default; }
  .tl__season-n { font-family: var(--font-mono); font-size: 0.7rem; color: var(--accent); letter-spacing: 0.1em; }
  .tl__season-l { font-size: 0.85rem; color: var(--ink); }
  .tl__hint { color: var(--ink-3); margin-inline-start: auto; }

  .tl__viewport {
    position: relative;
    overflow: auto;
    border-block: 1px solid var(--line-2);
    background:
      radial-gradient(60% 80% at 50% 0%, color-mix(in srgb, var(--accent) 7%, transparent), transparent 70%),
      var(--bg);
    cursor: grab;
    scrollbar-width: thin;
  }
  .tl__viewport.is-grabbing { cursor: grabbing; }
  .tl__svg { display: block; }

  .tl__year line { stroke: var(--line-2); stroke-width: 1; }
  .tl__year text { fill: var(--ink-3); font-family: var(--font-mono); font-size: 18px; text-anchor: middle; }
  .tl__lane { fill: var(--ink-3); font-family: var(--font-mono); font-size: 16px; letter-spacing: 0.18em; text-transform: uppercase; }

  .tl__edge {
    fill: none;
    stroke: var(--accent);
    stroke-width: 1.5;
    stroke-dasharray: 7 7;
    opacity: 0.45;
    animation: tl-flow 3s linear infinite;
  }
  @keyframes tl-flow { to { stroke-dashoffset: -28; } }

  .tl__node-halo { fill: transparent; stroke: var(--accent); stroke-width: 1; opacity: 0; transition: opacity var(--dur-fast) var(--ease); }
  .tl__node-dot { fill: var(--bg-3); stroke: var(--accent); stroke-width: 1.5; }
  .tl__node-code { fill: var(--ink-3); font-family: var(--font-mono); font-size: 15px; text-anchor: middle; letter-spacing: 0.12em; }
  .tl__node-title { fill: var(--ink); font-family: var(--font-display); font-size: 18px; text-anchor: middle; }
  .tl__node:hover .tl__node-halo,
  .tl__node:focus-visible .tl__node-halo { opacity: 0.8; }
  .tl__node:hover .tl__node-title { fill: var(--accent); }
  .tl__node.is-dimmed { opacity: 0.32; filter: grayscale(0.7); }

  @media (prefers-reduced-motion: reduce) {
    .tl__edge { animation: none; }
  }
  /* The whole map is desktop-only; phones use the parent's vertical list. */
  @media (max-width: 767px) {
    .tl { display: none; }
  }
</style>

<script>
  // Progressive enhancement: pan (drag + wheel), zoom (ctrl/⌘+wheel or pinch),
  // season-jump. Everything already works as a scrollable SVG without this.
  const vp = document.querySelector<HTMLElement>('.tl__viewport');
  const svg = document.querySelector<SVGSVGElement>('.tl__svg');
  if (vp && svg) {
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    let scale = 1;
    const baseW = svg.viewBox.baseVal.width;
    const baseH = svg.viewBox.baseVal.height;

    const applyScale = () => {
      svg.setAttribute('width', String(baseW * scale));
      svg.setAttribute('height', String(baseH * scale));
    };

    // drag to pan
    let down = false, sx = 0, sy = 0, sl = 0, st = 0;
    vp.addEventListener('pointerdown', (e) => {
      if ((e.target as Element).closest('.tl__node')) return; // let clicks through
      down = true; vp.classList.add('is-grabbing');
      sx = e.clientX; sy = e.clientY; sl = vp.scrollLeft; st = vp.scrollTop;
      vp.setPointerCapture(e.pointerId);
    });
    vp.addEventListener('pointermove', (e) => {
      if (!down) return;
      vp.scrollLeft = sl - (e.clientX - sx);
      vp.scrollTop = st - (e.clientY - sy);
    });
    const end = () => { down = false; vp.classList.remove('is-grabbing'); };
    vp.addEventListener('pointerup', end);
    vp.addEventListener('pointercancel', end);

    // zoom with ctrl/meta + wheel; plain wheel scrolls
    vp.addEventListener('wheel', (e) => {
      if (!(e.ctrlKey || e.metaKey)) return;
      e.preventDefault();
      const next = Math.min(2, Math.max(0.6, scale * (e.deltaY < 0 ? 1.1 : 0.9)));
      scale = next; applyScale();
    }, { passive: false });

    // keyboard: arrows pan, +/- zoom
    vp.addEventListener('keydown', (e) => {
      const step = 120;
      if (e.key === 'ArrowLeft') vp.scrollLeft -= step;
      else if (e.key === 'ArrowRight') vp.scrollLeft += step;
      else if (e.key === 'ArrowUp') vp.scrollTop -= step;
      else if (e.key === 'ArrowDown') vp.scrollTop += step;
      else if (e.key === '+' || e.key === '=') { scale = Math.min(2, scale * 1.1); applyScale(); }
      else if (e.key === '-') { scale = Math.max(0.6, scale * 0.9); applyScale(); }
      else return;
      e.preventDefault();
    });

    // season jump: scroll the representative x into view
    document.querySelectorAll<HTMLButtonElement>('.tl__season').forEach((b) => {
      b.addEventListener('click', () => {
        const x = Number(b.dataset.x || 0) * scale;
        const target = Math.max(0, x - vp.clientWidth / 2);
        vp.scrollTo({ left: target, behavior: reduce ? 'auto' : 'smooth' });
      });
    });

    // start centred on the newest (right end in LTR)
    requestAnimationFrame(() => {
      const rtl = document.querySelector('.tl')?.getAttribute('data-dir') === 'rtl';
      vp.scrollLeft = rtl ? 0 : vp.scrollWidth;
    });
  }
</script>
