---
import Sigil from './Sigil.astro';
import { t, url, LOCALES, LOCALE_META, TRACKS, type Locale, type Track } from '../i18n';

interface Props {
  locale: Locale;
  track: Track;
  pathParts: (string | number)[];
  buildSha: string;
}
const { locale, track, pathParts } = Astro.props;

// Language links keep the SAME page (pathParts) in the other locale.
const langLinks = LOCALES.map((l) => ({
  code: l,
  label: LOCALE_META[l].label,
  href: url(l, ...pathParts),
  active: l === locale,
}));

// Track links keep the current page type but swap the track segment when the
// current page is a track page (first part is a track). Otherwise point at the
// track home. Pages pass pathParts starting with the track for track-scoped pages.
const onTrackPage = TRACKS.includes(pathParts[0] as Track);
const trackLinks = TRACKS.map((tr) => ({
  code: tr,
  label: t(locale, `world.${tr}.name`),
  href: onTrackPage ? url(locale, tr, ...pathParts.slice(1)) : url(locale, tr),
  active: onTrackPage && tr === track,
}));

const cvHref = url(locale, 'cv', track);
const homeHref = url(locale, track);
---

<header class="site-header">
  <div class="shell site-header__inner">
    <a class="brand" href={homeHref} aria-label="Mohamed Essa — home">
      <Sigil size={30} />
      <span class="brand__name label">Mohamed Essa</span>
    </a>

    <nav class="site-header__nav" aria-label="Primary">
      <!-- Track switch: inline on wide screens, in the menu on phones -->
      <div class="switch switch--track" role="group" aria-label={t(locale, 'nav.track')}>
        {
          trackLinks.map((l) => (
            <a href={l.href} class:list={['switch__opt', { 'is-active': l.active }]} data-track={l.code}>
              {l.label}
            </a>
          ))
        }
      </div>

      <div class="switch switch--lang" role="group" aria-label={t(locale, 'nav.language')}>
        {
          langLinks.map((l) => (
            <a href={l.href} class:list={['switch__opt', { 'is-active': l.active }]} hreflang={l.code} lang={l.code}>
              {l.code.toUpperCase()}
            </a>
          ))
        }
      </div>

      <a class="cv-btn" href={cvHref} download>
        <span>{t(locale, 'nav.cv')}</span>
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" aria-hidden="true">
          <path d="M12 3v12m0 0l-4-4m4 4l4-4M5 21h14" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </a>

      <noscript>
        <!-- Without JS the hamburger can't open; expose language links inline. -->
        <span class="noscript-langs">
          {langLinks.map((l) => <a href={l.href} lang={l.code} class:list={['switch__opt', { 'is-active': l.active }]}>{l.code.toUpperCase()}</a>)}
        </span>
      </noscript>

      <button class="menu-btn" aria-expanded="false" aria-controls="mobile-menu">
        <span class="visually-hidden">{t(locale, 'nav.menu')}</span>
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" aria-hidden="true">
          <path d="M3 6h18M3 12h18M3 18h18" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
        </svg>
      </button>
    </nav>
  </div>

  <!-- Full-screen menu for phones -->
  <div id="mobile-menu" class="mobile-menu" hidden>
    <div class="mobile-menu__group">
      <p class="label">{t(locale, 'nav.track')}</p>
      {trackLinks.map((l) => <a href={l.href} class:list={{ 'is-active': l.active }}>{l.label}</a>)}
    </div>
    <div class="mobile-menu__group">
      <p class="label">{t(locale, 'nav.language')}</p>
      {langLinks.map((l) => <a href={l.href} lang={l.code} class:list={{ 'is-active': l.active }}>{l.label}</a>)}
    </div>
    <div class="mobile-menu__group">
      <p class="label">{t(locale, 'nav.contact')}</p>
      <a href="mailto:me@mecodes.live">me@mecodes.live</a>
      <a href="https://www.linkedin.com/in/mohamed-hosny-essa" target="_blank" rel="noopener">LinkedIn</a>
    </div>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    inset-block-start: 0;
    z-index: 50;
    background: color-mix(in srgb, var(--bg) 82%, transparent);
    backdrop-filter: blur(12px);
    border-block-end: 1px solid var(--line-2);
  }
  .site-header__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    block-size: 60px;
  }
  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
  }
  .brand__name {
    color: var(--ink);
  }
  .site-header__nav {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }
  .switch {
    display: inline-flex;
    gap: 2px;
    padding: 3px;
    background: var(--bg-2);
    border: 1px solid var(--line-2);
    border-radius: 999px;
  }
  .switch__opt {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.08em;
    padding: 0.3rem 0.7rem;
    border-radius: 999px;
    color: var(--ink-2);
    transition: color var(--dur-fast) var(--ease), background var(--dur-fast) var(--ease);
    white-space: nowrap;
  }
  .switch__opt.is-active {
    color: var(--accent-ink);
    background: var(--accent);
  }
  .switch__opt:not(.is-active):hover {
    color: var(--ink);
  }
  .cv-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.42rem 0.9rem;
    border: 1px solid var(--accent);
    color: var(--accent);
    border-radius: 999px;
    font-family: var(--font-mono);
    font-size: 0.78rem;
    letter-spacing: 0.06em;
    transition: background var(--dur-fast) var(--ease), color var(--dur-fast) var(--ease);
  }
  .cv-btn:hover {
    background: var(--accent);
    color: var(--accent-ink);
  }
  .menu-btn {
    display: none;
    color: var(--ink);
    padding: 0.3rem;
  }
  .noscript-langs {
    display: none;
    gap: 2px;
  }

  .mobile-menu {
    padding: 1.25rem var(--gutter) 2rem;
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    border-block-start: 1px solid var(--line-2);
  }
  .mobile-menu[hidden] { display: none; }
  .mobile-menu__group {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }
  .mobile-menu__group a {
    font-size: 1.1rem;
    color: var(--ink);
    padding: 0.35rem 0;
  }
  .mobile-menu__group a.is-active {
    color: var(--accent);
  }

  /* Phone: collapse inline switches into the menu */
  @media (max-width: 760px) {
    .switch--track,
    .switch--lang {
      display: none;
    }
    .menu-btn {
      display: inline-flex;
    }
    .noscript-langs {
      display: inline-flex;
    }
  }
</style>

<script>
  const btn = document.querySelector<HTMLButtonElement>('.menu-btn');
  const menu = document.getElementById('mobile-menu');
  btn?.addEventListener('click', () => {
    const open = btn.getAttribute('aria-expanded') === 'true';
    btn.setAttribute('aria-expanded', String(!open));
    if (menu) menu.hidden = open;
  });
</script>
