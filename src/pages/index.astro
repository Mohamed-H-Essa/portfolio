---
// Root: the ∞ intro at step 1 (language). No redirect any more: the visitor
// picks, with their browser language pre-highlighted. Without JS the three
// language names are plain links to /{lang}/ (the world step).
import Base from '../layouts/Base.astro';
import Intro from '../components/Intro.astro';
---

<Base locale="en" pathParts={[]} bare>
  <Intro locale="en" step="lang" />
</Base>
