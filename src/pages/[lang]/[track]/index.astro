---
// Track home: who this is, then every project on one vertical timeline, newest
// first (Timeline). A normal scrolling page; the 3D map (Scene) is no longer used.
import Base from '../../../layouts/Base.astro';
import Timeline from '../../../components/Timeline.astro';
import { LOCALES, TRACKS, isLocale, isTrack, type Locale, type Track } from '../../../i18n';
import { loadProjects, featuredForTrack, skillsForTrack } from '../../../lib/content';
import { personLd } from '../../../lib/schema';

export function getStaticPaths() {
  return LOCALES.flatMap((lang) => TRACKS.map((track) => ({ params: { lang, track } })));
}

const { lang, track } = Astro.params;
if (!lang || !isLocale(lang)) throw new Error(`bad lang param: ${lang}`);
if (!track || !isTrack(track)) throw new Error(`bad track param: ${track}`);
const locale: Locale = lang;
const tr: Track = track;

const projects = await loadProjects();
const featured = await featuredForTrack(tr);
const skills = await skillsForTrack(tr, 20);
---

<Base locale={locale} track={tr} pathParts={[tr]} jsonLd={[personLd(locale, skills)]}>
  <Timeline projects={projects} featured={featured} locale={locale} track={tr} />
</Base>
