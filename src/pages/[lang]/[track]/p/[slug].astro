---
// Project dossier (spec D4): the fixed structure recruiters scan — hero
// (title, layer, years, role, links, impact) → Problem / Built / Result →
// gallery or built-in diagram → stack → connected nodes → prev/next in world.
import Base from '../../../../layouts/Base.astro';
import DossierHero from '../../../../components/DossierHero.astro';
import DossierGallery from '../../../../components/DossierGallery.astro';
import PipelineFlow from '../../../../components/PipelineFlow.astro';
import NodeLink from '../../../../components/NodeLink.astro';
import { LOCALES, TRACKS, loc, t, type Locale, type Track } from '../../../../i18n';
import { loadProjects, type Project } from '../../../../lib/content';
import { worldSequence, prevNext } from '../../../../lib/dossier';
import { ogPath, galleryCount } from '../../../../lib/assets';
import '../../../../styles/engine.css';

export async function getStaticPaths() {
  const all = await loadProjects();
  return LOCALES.flatMap((lang) =>
    TRACKS.flatMap((track) => all.map((p) => ({ params: { lang, track, slug: p.data.slug } })))
  );
}

const { lang, track, slug } = Astro.params as { lang: Locale; track: Track; slug: string };
const all = await loadProjects();
const bySlug = new Map(all.map((p) => [p.data.slug, p]));
const project = bySlug.get(slug)!;
const d = project.data;

// connections in both directions (a node lists only its own `connects`)
const linked = new Set(d.connects);
for (const p of all) if (p.data.connects.includes(slug)) linked.add(p.data.slug);
const connected = [...linked].map((s) => bySlug.get(s)!).sort((a, b) => (a.data.start < b.data.start ? -1 : 1));

const seq = worldSequence(all.map((p) => p.data), track);
const { prev, next } = prevNext(seq, slug);
const nav = [
  prev && { p: bySlug.get(prev)!, rel: 'prev' as const },
  next && { p: bySlug.get(next)!, rel: 'next' as const },
].filter(Boolean) as { p: Project; rel: 'prev' | 'next' }[];

const title = loc(d.title, lang, slug);
const blocks = (['problem', 'built', 'result'] as const)
  .map((k) => ({ k, text: d[k] ? loc(d[k], lang, `${slug}.${k}`) : '' }))
  .filter((b) => b.text);
const shots = galleryCount(slug);

// the engine's frames, in order (each becomes one full-screen view)
const frames = [
  { id: 'overview', label: t(lang, 'dossier.overview') },
  blocks.length > 0 && { id: 'story', label: t(lang, 'dossier.story') },
  d.visual === 'release-flow' && { id: 'flow', label: t(lang, 'dossier.flow') },
  shots > 0 && { id: 'gallery', label: t(lang, 'dossier.gallery') },
  { id: 'details', label: t(lang, 'dossier.details') },
].filter(Boolean) as { id: string; label: string }[];
---

<Base
  locale={lang}
  track={track}
  title={title}
  description={d.impact?.line ? loc(d.impact.line, lang, slug) : undefined}
  pathParts={[track, 'p', slug]}
  ogImage={ogPath(slug)}
>
  <script is:inline slot="head" define:vars={{ slug }}>
    // engine mode is a progressive enhancement: without JS the dossier is a normal
    // scrolling page. Coming from the map's hand-off, the hero art is already in
    // place, so it must not animate in again.
    document.documentElement.classList.add('is-engine');
    try {
      if (sessionStorage.getItem('handoff') === slug) document.documentElement.classList.add('is-handoff', 'is-landing');
      sessionStorage.removeItem('handoff');
    } catch (e) {}
  </script>

  <article class="dossier" data-layer={d.worlds[0]} data-engine data-slug={slug}>
    <div class="frame frame--hero" data-frame id="f-overview">
      <DossierHero project={project} locale={lang} track={track} />
    </div>

    {
      blocks.length > 0 && (
        <div class="frame" data-frame id="f-story">
          <section class="pbr shell">
            {blocks.map((b, i) => (
              <div class="pbr__block">
                <h2 class="label">
                  <span class="pbr__n">{String(i + 1).padStart(2, '0')}</span> {t(lang, `dossier.${b.k}`)}
                </h2>
                <p>{b.text}</p>
              </div>
            ))}
          </section>
        </div>
      )
    }

    {
      d.visual === 'release-flow' && (
        <div class="frame" data-frame id="f-flow">
          <PipelineFlow locale={lang} />
        </div>
      )
    }

    {
      shots > 0 && (
        <div class="frame frame--gallery" data-frame id="f-gallery">
          <DossierGallery slug={slug} title={title} locale={lang} />
        </div>
      )
    }

    <div class="frame" data-frame id="f-details">
      <div class="details">
        {
          d.stack.length > 0 && (
            <section class="stack shell" aria-labelledby="stack-h">
              <h2 id="stack-h" class="label">{t(lang, 'dossier.stack')}</h2>
              <ul class="chips">
                {d.stack.map((s) => <li>{s}</li>)}
              </ul>
            </section>
          )
        }

        {
          connected.length > 0 && (
            <section class="related shell" aria-labelledby="rel-h">
              <h2 id="rel-h" class="label">{t(lang, 'dossier.connected')}</h2>
              <div class="related__grid">
                {connected.map((p) => <NodeLink project={p} locale={lang} track={track} />)}
              </div>
            </section>
          )
        }

        {
          nav.length > 0 && (
            <nav class="pager shell" aria-label={`${t(lang, 'dossier.prev')} / ${t(lang, 'dossier.next')}`}>
              {nav.map((n) => (
                <div class:list={['pager__slot', `pager__slot--${n.rel}`]}>
                  <NodeLink project={n.p} locale={lang} track={track} rel={n.rel} />
                </div>
              ))}
            </nav>
          )
        }
      </div>
    </div>
  </article>

  {/* HUD: only shown in engine mode (engine.css) */}
  <div class="hud" data-hud>
    <ol class="hud__rail" aria-label={title}>
      {frames.map((f, i) => (
        <li>
          <button type="button" class="hud__tick" data-go={i} aria-label={f.label}>
            <span class="hud__label">{f.label}</span>
          </button>
        </li>
      ))}
    </ol>
    <p class="hud__count label" aria-hidden="true"><span data-count>01</span> / {String(frames.length).padStart(2, '0')}</p>
    <button type="button" class="hud__next" data-next>
      <span class="hud__next-label" data-next-label>{frames[1] ? `${t(lang, 'dossier.nextLabel')}: ${frames[1].label}` : ''}</span>
      <span class="hud__next-arrow" aria-hidden="true">↓</span>
    </button>
  </div>
  <script type="application/json" data-engine-json set:html={JSON.stringify({ next: t(lang, 'dossier.nextLabel'), back: t(lang, 'dossier.back'), labels: frames.map((f) => f.label) })} />
</Base>

<style>
  .dossier { --c: var(--origin); padding-block-end: 4rem; }
  .dossier[data-layer='mobile'] { --c: var(--mobile); }
  .dossier[data-layer='cloud'] { --c: var(--cloud); }
  .dossier section > h2 { margin-block-end: 1.1rem; }

  .pbr {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 17rem), 1fr));
    gap: 1.25rem clamp(1.5rem, 4vw, 3.5rem);
    padding-block: 3rem;
    border-block-start: 1px solid var(--line-2);
  }
  .pbr__block p { color: var(--ink); line-height: 1.6; max-inline-size: 38ch; }
  .pbr__block h2 { margin-block-end: 0.75rem; }
  .pbr__n { color: var(--c); margin-inline-end: 0.5em; }

  .stack, .related, .pager { padding-block: 2rem; }
  .chips { list-style: none; padding: 0; display: flex; flex-wrap: wrap; gap: 0.5rem; }
  .chips li {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    padding: 0.45rem 0.85rem;
    border: 1px solid var(--line);
    border-radius: 999px;
    color: var(--ink-2);
  }
  .related__grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 16rem), 1fr)); gap: 0.75rem; }

  .pager { display: grid; grid-template-columns: 1fr 1fr; gap: 0.75rem; border-block-start: 1px solid var(--line-2); padding-block-start: 2.5rem; }
  .pager__slot--next { grid-column: 2; }
  .pager__slot--next :global(.node) { flex-direction: row-reverse; text-align: end; padding-inline: 1rem 0.6rem; }
  @media (max-width: 560px) {
    .pager { grid-template-columns: 1fr; }
    .pager__slot--next { grid-column: 1; }
  }
</style>

<script>
  import { initEngine } from '../../../../scripts/dossier-engine';
  document.querySelectorAll<HTMLElement>('[data-engine]').forEach(initEngine);
</script>
