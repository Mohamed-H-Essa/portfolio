---
// /{lang}/: the ∞ intro at step 2 (world). The lobes are links to the three
// track maps; "Change language" goes back to step 1 (in place with JS).
import Base from '../../layouts/Base.astro';
import Intro from '../../components/Intro.astro';
import { LOCALES, isLocale, type Locale } from '../../i18n';
import { personLd, websiteLd } from '../../lib/schema';
import { skillsForTrack } from '../../lib/content';

export function getStaticPaths() {
  return LOCALES.map((lang) => ({ params: { lang } }));
}

const { lang } = Astro.params;
if (!lang || !isLocale(lang)) throw new Error(`bad lang param: ${lang}`);
const locale: Locale = lang;
const skills = await skillsForTrack('all', 20);
---

<Base locale={locale} track="all" pathParts={[]} bare jsonLd={[personLd(locale, skills), websiteLd(locale)]}>
  <Intro locale={locale} step="world" />
</Base>
