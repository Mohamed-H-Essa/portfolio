---
// World chooser — the first screen at /{lang}/. Desktop: three tall columns
// that widen on hover/focus with an accent glow. Phone: three stacked panels.
// The name does a masked-type reveal (kit #09) that degrades to static text.
import Base from '../../layouts/Base.astro';
import Sigil from '../../components/Sigil.astro';
import { LOCALES, TRACKS, isLocale, t, url, type Locale } from '../../i18n';

export function getStaticPaths() {
  return LOCALES.map((lang) => ({ params: { lang } }));
}

const { lang } = Astro.params;
if (!lang || !isLocale(lang)) throw new Error(`bad lang param: ${lang}`);
const locale: Locale = lang;
---

<Base locale={locale} track="all" pathParts={[]}>
  <section class="chooser">
    <div class="chooser__intro shell">
      <Sigil size={44} />
      <h1 class="reveal" data-text="Mohamed Essa">
        <span>Mohamed Essa</span>
      </h1>
      <p class="label chooser__eyebrow">{t(locale, 'world.chooser.eyebrow')}</p>
      <p class="chooser__sub">{t(locale, 'world.chooser.sub')}</p>
    </div>

    <ul class="worlds">
      {
        TRACKS.map((tr) => (
          <li class="world" data-track={tr}>
            <a href={url(locale, tr)} aria-label={t(locale, `world.${tr}.name`)}>
              <span class="world__glow" aria-hidden="true" />
              <span class="world__content">
                <span class="world__index label">{tr === 'mobile' ? '01' : tr === 'cloud' ? '02' : '03'}</span>
                <span class="world__name">{t(locale, `world.${tr}.name`)}</span>
                <span class="world__desc">{t(locale, `world.${tr}.desc`)}</span>
                <span class="world__enter label">{t(locale, 'map.openProject')} →</span>
              </span>
            </a>
          </li>
        ))
      }
    </ul>
  </section>
</Base>

<style>
  .chooser {
    min-block-size: calc(100svh - 60px);
    display: flex;
    flex-direction: column;
  }
  .chooser__intro {
    padding-block: clamp(2rem, 6vh, 4rem) 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }
  .chooser__intro h1 {
    font-size: var(--fs-h1);
    margin-block: 0.4rem 0.2rem;
  }
  .chooser__eyebrow {
    color: var(--ink-2);
  }
  .chooser__sub {
    color: var(--ink-2);
    max-inline-size: 48ch;
  }

  /* Masked-type reveal: an accent sweep rises through the name once. */
  .reveal {
    position: relative;
    color: var(--ink);
  }
  .reveal span {
    background: linear-gradient(0deg, var(--accent), var(--ink) 55%);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    background-size: 100% 220%;
    background-position: 0 100%;
    animation: reveal-rise 1100ms var(--ease) forwards;
  }
  @keyframes reveal-rise {
    to { background-position: 0 0; }
  }

  .worlds {
    list-style: none;
    margin: 0;
    padding: 0;
    flex: 1;
    display: grid;
    grid-template-columns: 1fr;
    gap: 2px;
    background: var(--line-2);
  }
  .world {
    --w: var(--origin);
    position: relative;
  }
  .world[data-track='mobile'] { --w: var(--mobile); }
  .world[data-track='cloud'] { --w: var(--cloud); }
  .world[data-track='all'] { --w: var(--origin); }

  .world a {
    position: relative;
    display: block;
    block-size: 100%;
    min-block-size: 112px;
    padding: 1.4rem var(--gutter);
    background: var(--bg);
    overflow: hidden;
    transition: background var(--dur) var(--ease);
  }
  .world__glow {
    position: absolute;
    inset: 0;
    background: radial-gradient(60% 120% at 20% 50%, color-mix(in srgb, var(--w) 20%, transparent), transparent 70%);
    opacity: 0;
    transition: opacity var(--dur) var(--ease);
  }
  .world a:hover .world__glow,
  .world a:focus-visible .world__glow {
    opacity: 1;
  }
  .world__content {
    position: relative;
    display: grid;
    gap: 0.35rem;
    max-inline-size: 42ch;
  }
  .world__index { color: var(--ink-3); }
  .world__name {
    font-family: var(--font-display);
    font-size: var(--fs-h2);
    line-height: 1;
    color: var(--w);
  }
  .world__desc { color: var(--ink-2); }
  .world__enter {
    color: var(--w);
    opacity: 0;
    transform: translateX(-4px);
    transition: opacity var(--dur) var(--ease), transform var(--dur) var(--ease);
  }
  :root[dir='rtl'] .world__enter { transform: translateX(4px); }
  .world a:hover .world__enter,
  .world a:focus-visible .world__enter {
    opacity: 1;
    transform: none;
  }

  /* Desktop: three columns that widen on hover. */
  @media (min-width: 880px) {
    .worlds {
      grid-template-columns: 1fr 1fr 1fr;
      transition: grid-template-columns var(--dur-slow) var(--ease);
    }
    .worlds:has(.world:nth-child(1) a:hover) { grid-template-columns: 1.6fr 1fr 1fr; }
    .worlds:has(.world:nth-child(2) a:hover) { grid-template-columns: 1fr 1.6fr 1fr; }
    .worlds:has(.world:nth-child(3) a:hover) { grid-template-columns: 1fr 1fr 1.6fr; }
    .world a {
      display: flex;
      align-items: flex-end;
      min-block-size: 0;
    }
    .world:not(:last-child) a { border-inline-end: 1px solid var(--line-2); }
  }

  @media (prefers-reduced-motion: reduce) {
    .reveal span { animation: none; background: none; -webkit-text-fill-color: var(--ink); color: var(--ink); }
    .worlds, .world__enter, .world__glow { transition: none; }
  }
</style>

<script>
  // Remember the last chosen track (URLs still always win); purely a convenience.
  document.querySelectorAll<HTMLAnchorElement>('.world a').forEach((a) => {
    a.addEventListener('click', () => {
      const tr = a.closest('.world')?.getAttribute('data-track');
      try {
        if (tr) localStorage.setItem('track', tr);
      } catch {
        /* storage blocked */
      }
    });
  });
</script>
